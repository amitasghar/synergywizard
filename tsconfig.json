{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "datagen/**/*.ts"
  ],
  "exclude": [
    "src/components",
    "src/state",
    "src/export",
    "src/api/client.ts",
    "src/api/client.test.ts",
    "src/hooks/useEmbedder.test.ts"
  ]
}
